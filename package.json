{
  "name": "pi-claude-bridge",
  "version": "0.3.1",
  "private": false,
  "description": "Pi extension that uses Claude Code as a model provider.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "claude-code"
  ],
  "author": "Eli Dickinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elidickinson/pi-claude-bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "convert.ts",
    "models.ts",
    "dist/**",
    "README.md",
    "LICENSE",
    "claude-bridge1.png",
    "claude-bridge2.png"
  ],
  "bin": {
    "pi-claude-bridge-shim": "dist/src/mcp/shim.js"
  },
  "scripts": {
    "test:unit": "node --import tsx --test tests/unit-*.mjs",
    "test": "set -a && [ -f .env.test ] && . .env.test; set +a && npm run test:unit && tests/int-smoke.sh && tests/int-multi-turn.sh && tests/int-cache.sh && node --import tsx --test --test-concurrency=1 tests/int-*.mjs",
    "test:usage": "tests/usage-test.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "change-case": "^5.4.4",
    "claude-p": "github:cartwmic/claude-p#415f4ba0b1407f2e21ce62c294aa5e3978c2c64c",
    "pino": "^10.3.1",
    "rotating-file-stream": "^3.2.9"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.67.6",
    "@mariozechner/pi-coding-agent": "^0.66.1",
    "@types/node": "^24.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
